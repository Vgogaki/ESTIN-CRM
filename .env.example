# Copy this file to .env and fill in real values. Never commit .env.

# Local Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://estin:estin_dev_password@localhost:5432/estin_crm"

# Session / auth secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Shared secret for POST /api/v1/orders (checkout -> CRM). Placeholder until
# real API key management exists (spec §5.7). Generate with: openssl rand -base64 24
ORDERS_API_KEY=""

# AES-256-GCM key for encrypting KYC documents at rest — 32 bytes, base64.
# Generate with: openssl rand -base64 32
# Losing this key makes every stored KYC document permanently unreadable.
# Back it up somewhere durable and separate from the database backup.
KYC_ENCRYPTION_KEY=""

# Where encrypted KYC document files are written locally. Not a production
# storage answer — see src/server/kyc-storage.ts.
KYC_STORAGE_DIR=""

# Email (module 4.5). Until a provider is chosen leave EMAIL_DRIVER unset:
# emails are then only recorded and printed in the server log, not delivered.
# To deliver, use any provider's SMTP relay:
#   EMAIL_DRIVER="smtp"
#   SMTP_URL="smtps://username:password@smtp.provider.example:465"
#   EMAIL_FROM="ESTIN <no-reply@your-domain>"   (domain needs SPF/DKIM/DMARC)
# APP_BASE_URL is put in links inside emails (verify, reset, unsubscribe).
EMAIL_DRIVER=""
SMTP_URL=""
EMAIL_FROM=""
APP_BASE_URL="http://localhost:3000"

# Hosted review copy only (docs/hosting-review.md). Leave all of these unset locally.
#   REVIEW_GATE="on"                  password gate in front of the whole site (fails closed if the password is missing)
#   REVIEW_GATE_USER="reviewer"
#   REVIEW_GATE_PASSWORD=""           generate a long random one
#   RUN_SEED="on"                     create roles + admin accounts at start
#   SEED_FOUNDER_PASSWORD=""          12+ characters; otherwise a random one is printed once
#   SEED_COFOUNDER_EMAIL="" / SEED_COFOUNDER_PASSWORD=""   optional second admin
#   ALLOW_DEMO_SEED="yes"             load fake demo data (refuses if any real person exists)

# IP geolocation (module 6.5). Until a provider is chosen leave GEOIP_DRIVER
# unset: every login IP resolves to "unknown" and the country-mismatch check
# never fires. To enable, use any provider with a "country code only" GET
# endpoint (e.g. https://ipapi.co/{ip}/country/ — the literal text "{ip}" is
# replaced with the address):
#   GEOIP_DRIVER="http"
#   GEOIP_API_URL="https://ipapi.co/{ip}/country/"
GEOIP_DRIVER=""
GEOIP_API_URL=""
