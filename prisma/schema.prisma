// ESTIN CRM — data model
// Source of truth: docs/crm-specification.md (§3) and docs/modules-to-design.md (§1.5/1.6, §1.7)
// Every write to a business record must be paired with an AuditLog entry — see src/server/audit.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Shared enums
// ---------------------------------------------------------------------------

enum KycStatus {
  not_started
  submitted
  verified
  rejected
}

enum ProductType {
  standard
  promotional
  competition_linked
  instant_funded
}

enum DrawdownType {
  trailing
  static
}

enum KycTiming {
  at_creation
  after_evaluation
  at_first_payout
}

enum AccountPhase {
  evaluation
  pass_review
  funded
  closed
}

enum AccountStatus {
  active
  passed
  breached
  closed
}

enum WithdrawalStatus {
  pending
  approved
  declined
  paid
}

enum ActorType {
  admin
  trader
  system
  integration
}

enum AuthTokenPurpose {
  email_verification
  password_reset
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
  partially_refunded
  charged_back
}

enum KycDocumentType {
  identity_front
  identity_back
  proof_of_address
  selfie
}

// In-app only for now (module 4.4) — the "Email" column in
// modules-to-design.md §4.4/4.5 is a separate, still-unbuilt concern
// blocked on a transactional email provider decision, same as the
// verification-link emails that are currently a dev console log
// (src/server/auth). Not every event in that table has a trigger built
// yet — only the ones from events this codebase actually produces so far
// (order intake, breach/pass automation, expiry sweep, KYC review).
enum NotificationType {
  account_created
  phase_passed
  breach
  account_expired
  kyc_submitted
  kyc_verified
  kyc_rejected
  payout_requested
  payout_approved
  payout_declined
  offer_received
  competition_results
  support_reply
}

model Notification {
  id       String           @id @default(cuid())
  personId String
  person   Person           @relation(fields: [personId], references: [id])
  type     NotificationType
  title    String
  body     String
  link     String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([personId, createdAt])
  @@index([personId, readAt])
}

// ---------------------------------------------------------------------------
// Offers & discount campaigns (module 7.1) — re-purchase offers for
// breached traders, primarily. See src/server/offers.ts for the redemption
// logic and why maxUses is enforced at issue time, not just at redemption.
// ---------------------------------------------------------------------------

enum OfferDiscountType {
  percent
  fixed
}

enum OfferAudience {
  all_traders
  breached_traders
  competition_entrants
  specific_trader
}

enum OfferStatus {
  sent
  redeemed
  withdrawn
}

model OfferCampaign {
  id            String            @id @default(cuid())
  name          String
  code          String            @unique
  discountType  OfferDiscountType
  discountValue Decimal           @db.Decimal(10, 2)
  audience      OfferAudience
  // Which challenge family this applies to — null means any. A family, not
  // a specific version, so the campaign stays valid across a re-version.
  challengeTypeFamilyId String?

  // Days after a breach before this offer may be sent to a breached trader
  // (docs/decisions.md: "sent after a configurable delay, default 3 days,
  // not instantly" — no time-pressured upsell straight after a loss).
  // Only applies to the breached_traders audience; 0 means send at once.
  sendDelayDays Int @default(3)

  validFrom DateTime
  validTo   DateTime
  // Cap on issued-or-redeemed offers (withdrawn ones free the slot back
  // up). Null means unlimited.
  maxUses Int?
  active  Boolean @default(true)

  createdAt   DateTime   @default(now())
  createdById String?
  createdBy   AdminUser? @relation(fields: [createdById], references: [id])

  issuedOffers IssuedOffer[]

  @@index([code])
}

// One offer sent to one trader against one campaign. normalFee/offerFee are
// frozen at issue time — editing the campaign afterwards never changes an
// already-issued offer.
model IssuedOffer {
  id              String        @id @default(cuid())
  campaignId      String
  campaign        OfferCampaign @relation(fields: [campaignId], references: [id])
  personId        String
  person          Person        @relation(fields: [personId], references: [id])
  challengeTypeId String
  challengeType   ChallengeType @relation(fields: [challengeTypeId], references: [id])

  normalFee Decimal     @db.Decimal(14, 2)
  offerFee  Decimal     @db.Decimal(14, 2)
  status    OfferStatus @default(sent)

  issuedAt   DateTime  @default(now())
  issuedById String
  issuedBy   AdminUser @relation(fields: [issuedById], references: [id])
  expiresAt  DateTime

  redeemedOrderRef String?
  redeemedAt       DateTime?
  withdrawnReason  String?

  @@index([personId])
  @@index([campaignId])
}

// ---------------------------------------------------------------------------
// Challenge Builder — rules live on versioned templates, never on accounts.
// Editing a live template creates a new ChallengeType row (new version);
// existing accounts keep referencing the row (and therefore the version)
// they were pinned to at purchase. See CLAUDE.md "Challenge rules".
// ---------------------------------------------------------------------------

model ChallengeType {
  id          String      @id @default(cuid())
  familyId    String
  version     Int
  name        String
  description String?
  productType ProductType @default(standard)

  accountSize Decimal @db.Decimal(14, 2)
  fee         Decimal @db.Decimal(14, 2)
  currency    String  @default("EUR")

  leverageCap          Int
  permittedInstruments String[]
  kycTiming            KycTiming @default(after_evaluation)

  // Sellable vs archived. Only one version per familyId should be active.
  active Boolean @default(false)

  createdAt   DateTime   @default(now())
  publishedAt DateTime?
  createdById String?
  createdBy   AdminUser? @relation(fields: [createdById], references: [id])

  phases          ChallengePhase[]
  accounts        Account[]
  termsAcceptance TermsAcceptance[]
  issuedOffers    IssuedOffer[]

  @@unique([familyId, version])
  @@index([familyId])
}

// One row per phase in the Challenge Builder (0..n). A funded-stage row
// (isFunded = true) carries profit split / payout terms instead of a
// profit target. See docs/modules-to-design.md §1.5/1.6.
model ChallengePhase {
  id              String        @id @default(cuid())
  challengeTypeId String
  challengeType   ChallengeType @relation(fields: [challengeTypeId], references: [id], onDelete: Cascade)

  order    Int
  label    String
  isFunded Boolean @default(false)

  // Evaluation-phase rules (null on the funded-stage row)
  profitTargetPct Decimal?     @db.Decimal(6, 3)
  dailyLossPct    Decimal      @db.Decimal(6, 3)
  maxLossPct      Decimal      @db.Decimal(6, 3)
  drawdownType    DrawdownType @default(trailing)
  minTradingDays  Int          @default(0)
  timeLimitDays   Int?
  consistencyRule Json?

  // Funded-stage rules (null on evaluation-phase rows)
  profitSplitPct  Decimal? @db.Decimal(5, 2)
  payoutCycleDays Int?
  minPayoutAmount Decimal? @db.Decimal(14, 2)

  accountsCurrentlyOnPhase Account[]

  @@unique([challengeTypeId, order])
}

// ---------------------------------------------------------------------------
// People and accounts — one person, many accounts. KYC on the person.
// ---------------------------------------------------------------------------

model Person {
  id       String @id @default(cuid())
  fullName String
  email    String @unique
  country  String

  kycStatus          KycStatus @default(not_started)
  kycRejectionReason String?
  identityMismatch   Boolean   @default(false)
  marketingConsent   Boolean   @default(false)

  passwordHash        String?
  emailVerifiedAt     DateTime?
  twoFactorSecret     String?
  twoFactorEnabledAt  DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Void-with-reason soft delete. GDPR erasure anonymises the row instead
  // (see src/server/gdpr.ts) but never removes it — financial history stays.
  voidedAt   DateTime?
  voidReason String?
  voidedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts           Account[]
  sessions           TraderSession[]
  termsAcceptance    TermsAcceptance[]
  notes              Note[]
  payments           Payment[]
  kycDocuments       KycDocument[]
  notifications      Notification[]
  issuedOffers       IssuedOffer[]
  competitionEntries CompetitionEntry[]
  countryReviews     CountryReview[]
  linksAsA           AccountLink[]      @relation("AccountLinkA")
  linksAsB           AccountLink[]      @relation("AccountLinkB")
  supportThreads     SupportThread[]

  @@index([email])
}

model Account {
  id              String          @id @default(cuid())
  personId        String
  person          Person          @relation(fields: [personId], references: [id])
  challengeTypeId String
  challengeType   ChallengeType   @relation(fields: [challengeTypeId], references: [id])
  currentPhaseId  String?
  currentPhase    ChallengePhase? @relation(fields: [currentPhaseId], references: [id])

  orderRef String @unique

  phase  AccountPhase  @default(evaluation)
  status AccountStatus @default(active)

  equity         Decimal @db.Decimal(14, 2)
  balance        Decimal @db.Decimal(14, 2)
  dayStartEquity Decimal @db.Decimal(14, 2)
  peakEquity     Decimal @db.Decimal(14, 2)
  tradingDays    Int     @default(0)

  startedAt DateTime @default(now())
  // When the account entered currentPhase — the clock a phase's timeLimitDays
  // (module 3.5) counts from. Equal to startedAt at creation; would need
  // updating alongside currentPhaseId on a real multi-phase advance, which
  // isn't built yet (today's only phase transitions are pass_review/closed,
  // neither of which changes currentPhaseId).
  phaseStartedAt DateTime  @default(now())
  endedAt        DateTime?
  closeReason    String?

  voidedAt   DateTime?
  voidReason String?
  voidedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equityTicks     EquityTick[]
  withdrawals     Withdrawal[]
  termsAcceptance TermsAcceptance[]
  payments        Payment[]

  @@index([personId])
  @@index([challengeTypeId])
}

// One row per note logged against a person (call summary, breach detail,
// payout decision context). Notes belong to the person, not an account —
// matches "KYC belongs to the person" (CLAUDE.md).
model Note {
  id            String    @id @default(cuid())
  personId      String
  person        Person    @relation(fields: [personId], references: [id])
  authorAdminId String
  authorAdmin   AdminUser @relation(fields: [authorAdminId], references: [id])
  text          String
  createdAt     DateTime  @default(now())

  @@index([personId])
}

// Money received against an order (spec §8.1). Status starts "succeeded"
// because POST /api/v1/orders is only called after checkout confirms
// payment — there is no real payment provider wired up yet (decision #5,
// still open), so refund/chargeback status transitions aren't driven by a
// real webhook yet either; the field exists so that plugging a provider in
// later doesn't require a schema change.
model Payment {
  id                    String        @id @default(cuid())
  personId              String
  person                Person        @relation(fields: [personId], references: [id])
  accountId             String
  account               Account       @relation(fields: [accountId], references: [id])
  orderRef              String        @unique
  amountPaid            Decimal       @db.Decimal(14, 2)
  currency              String
  paymentProvider       String
  providerTransactionId String?
  // Hash of the provider's card/instrument fingerprint token (never card
  // data) — lets 6.1 link people paying with the same instrument. Null
  // until a payment provider (decision #5) supplies one.
  paymentFingerprint    String?
  affiliateCode         String?
  status                PaymentStatus @default(succeeded)
  createdAt             DateTime      @default(now())

  @@index([personId])
  @@index([accountId])
  @@index([paymentFingerprint])
}

// The row is metadata only — never the file itself. The actual bytes live
// encrypted in KYC_STORAGE_DIR (see src/server/kyc-storage.ts), keyed by
// storageKey; storing them in the database would put unencrypted-at-the-
// column-level personal documents in ordinary DB backups and read
// replicas. checksum is a SHA-256 of the plaintext, so a corrupted or
// tampered file is detectable independent of decryption succeeding.
model KycDocument {
  id           String          @id @default(cuid())
  personId     String
  person       Person          @relation(fields: [personId], references: [id])
  type         KycDocumentType
  storageKey   String          @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  checksum     String
  uploadedAt   DateTime        @default(now())

  @@index([personId])
}

model EquityTick {
  id           String   @id @default(cuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id])
  equity       Decimal  @db.Decimal(14, 2)
  balance      Decimal  @db.Decimal(14, 2)
  openPnl      Decimal  @db.Decimal(14, 2)
  closedTrades Int
  tradingDay   DateTime @db.Date
  timestamp    DateTime
  createdAt    DateTime @default(now())

  @@index([accountId, timestamp])
}

// ---------------------------------------------------------------------------
// Competitions (module 7.2) — see src/server/competitions.ts. Unlike every
// other 🟢 module in v1-build-plan.md, this one has no prototype at all
// (checked: zero references in prototypes/back-office.jsx and
// trader-portal.jsx) — only crm-specification.md §7's prose. Two things in
// that spec are explicit open items, not implementation details, so they're
// built as configuration rather than guessed:
//   - §7.2: "Tie-breaker rule. Must be defined before launch." — required
//     per-competition, not a hardcoded assumption.
//   - §7.4: paid-entry contests can fall under gaming/lottery regulation;
//     "obtain Cyprus legal advice before launch." legalSignOffConfirmed
//     gates any competition with a non-zero entry fee from ever going
//     active — see setCompetitionStatus() in competitions.ts.
// ---------------------------------------------------------------------------

enum CompetitionStatus {
  draft
  active
  closed
}

enum RankingMetric {
  return_pct
  absolute_pnl
}

enum CompetitionEntryStatus {
  active
  disqualified
}

model Competition {
  id                 String            @id @default(cuid())
  name               String
  startDate          DateTime
  endDate            DateTime
  entryFee           Decimal           @db.Decimal(14, 2) @default(0)
  currency           String            @default("EUR")
  entrantCap         Int?
  demoAccountSize    Decimal           @db.Decimal(14, 2)
  minTradesToQualify Int               @default(0)
  rankingMetric      RankingMetric     @default(return_pct)
  tieBreakerRule     String
  // Ordered list of {rank, type: "cash"|"funded_account"|"free_challenge"|"discount", description, cashValue?}.
  // Only "cash" entries have a quantifiable cost — see prizeCostCommitted() in competitions.ts.
  prizeLadder Json

  status                  CompetitionStatus @default(draft)
  legalSignOffConfirmed   Boolean           @default(false)
  legalSignOffNote        String?

  createdAt   DateTime   @default(now())
  createdById String?
  createdBy   AdminUser? @relation(fields: [createdById], references: [id])

  entries CompetitionEntry[]
}

// A competition entrant's demo account. Deliberately separate from Account
// (the challenge-evaluation model) — a competition entry isn't a purchased
// challenge and shouldn't inherit that model's phase/status/void semantics.
// equity/tradesCount stand in for a real feed the same way Account's
// manually-set equity fields do until 3.2/3.3 exist.
model CompetitionEntry {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])
  personId      String
  person        Person      @relation(fields: [personId], references: [id])

  entryPaidAmount Decimal @db.Decimal(14, 2)
  equity          Decimal @db.Decimal(14, 2)
  tradesCount     Int     @default(0)

  status             CompetitionEntryStatus @default(active)
  disqualifiedReason String?

  enteredAt DateTime @default(now())

  @@unique([competitionId, personId])
  @@index([competitionId])
  @@index([personId])
}

model Withdrawal {
  id        String           @id @default(cuid())
  accountId String
  account   Account          @relation(fields: [accountId], references: [id])
  profit    Decimal          @db.Decimal(14, 2)
  splitPct  Decimal          @db.Decimal(5, 2)
  amount    Decimal          @db.Decimal(14, 2)
  method    String?
  // Payout rail reference (module 5.3, not built — blocked on a payout
  // provider decision, docs/decisions.md #7). Nullable and unused until
  // then, same forward-compatible pattern as Payment.providerTransactionId.
  providerReference String?
  status            WithdrawalStatus @default(pending)

  requestedAt  DateTime   @default(now())
  decidedById  String?
  decidedBy    AdminUser? @relation(fields: [decidedById], references: [id])
  decidedAt    DateTime?
  decisionNote String?

  @@index([accountId])
  @@index([status])
}

// At purchase: which rulebook/terms version the trader accepted, matched to
// the exact challenge-type version they bought. Dispute evidence.
// See docs/modules-to-design.md §1.7.
model TermsAcceptance {
  id              String        @id @default(cuid())
  personId        String
  person          Person        @relation(fields: [personId], references: [id])
  accountId       String
  account         Account       @relation(fields: [accountId], references: [id])
  challengeTypeId String
  challengeType   ChallengeType @relation(fields: [challengeTypeId], references: [id])
  termsVersion    String
  acceptedAt      DateTime      @default(now())
  ipAddress       String

  @@index([personId])
}

// ---------------------------------------------------------------------------
// Back-office admin users, roles and sessions
// ---------------------------------------------------------------------------

model AdminRole {
  id          String   @id @default(cuid())
  name        String   @unique
  // Flat list of permission strings, e.g. "traders.view", "payouts.approve".
  // See docs/modules-to-design.md §1.3 for the starting role set.
  permissions String[]

  users AdminUser[]
}

model AdminUser {
  id     String    @id @default(cuid())
  email  String    @unique
  name   String
  roleId String
  role   AdminRole @relation(fields: [roleId], references: [id])

  passwordHash        String
  twoFactorSecret     String?
  twoFactorEnabledAt  DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions            AdminSession[]
  createdChallenges   ChallengeType[]
  decidedWithdrawals  Withdrawal[]
  notes               Note[]
  createdCampaigns    OfferCampaign[]
  issuedOffers        IssuedOffer[]
  createdCompetitions Competition[]
  supportMessages     SupportMessage[]

  @@index([email])
}

model AdminSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])
  ipAddress   String
  userAgent   String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime

  @@index([adminUserId])
}

model TraderSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  personId  String
  person    Person   @relation(fields: [personId], references: [id])
  ipAddress String
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([personId])
}

// Shared by trader and admin flows: email verification and password reset.
model AuthToken {
  id        String           @id @default(cuid())
  actorType ActorType
  actorId   String
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([actorType, actorId])
}

// ---------------------------------------------------------------------------
// Audit log — append-only. No application code should ever update or delete
// a row here. A database-level trigger enforcing that ships with module 1.4.
// ---------------------------------------------------------------------------

model AuditLog {
  id         String    @id @default(cuid())
  timestamp  DateTime  @default(now())
  actorType  ActorType
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  ipAddress  String?

  @@index([entityType, entityId])
  @@index([actorType, actorId])
  @@index([timestamp])
}

// ---------------------------------------------------------------------------
// Restricted countries (module 6.3) — see src/server/countries.ts.
// The rows ARE the list: none are seeded, because what belongs on it is a
// legal/business decision (docs/decisions.md #11), not a development one —
// "do not ship a default list copied from elsewhere" (modules-to-design.md
// §6.1–6.5). A country with no row is allowed at every stage.
// ---------------------------------------------------------------------------

enum CountryAction {
  allowed
  review
  blocked
}

enum CountryStage {
  registration
  purchase
  trading
  payout
}

enum CountryReviewStatus {
  open
  cleared
}

model CountryRule {
  id          String        @id @default(cuid())
  countryCode String        @unique
  registration CountryAction @default(allowed)
  purchase     CountryAction @default(allowed)
  // Stored for completeness (spec: applied separately to all four), but
  // nothing can enforce it until a trading platform exists (3.3).
  trading      CountryAction @default(allowed)
  payout       CountryAction @default(allowed)
  note         String?
  updatedAt    DateTime      @updatedAt
  updatedById  String?
}

// A "review" outcome: the action isn't blocked, but a person needs a human
// look. Open payout-stage reviews block payout approval (countries.ts).
model CountryReview {
  id          String              @id @default(cuid())
  personId    String
  person      Person              @relation(fields: [personId], references: [id])
  stage       CountryStage
  countryCode String
  status      CountryReviewStatus @default(open)
  createdAt   DateTime            @default(now())
  resolvedAt  DateTime?
  resolvedById String?
  resolutionNote String?

  @@index([personId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Multiple-account detection (module 6.1) — see src/server/account-links.ts.
// Links are between two different PEOPLE (one person with many accounts is
// normal and by design). "Flag for review; do not auto-block" — nothing here
// blocks anything.
// ---------------------------------------------------------------------------

enum AccountLinkStatus {
  open
  dismissed
  confirmed
}

enum AccountLinkStrength {
  weak
  strong
}

model AccountLink {
  id        String @id @default(cuid())
  // Always stored with personAId < personBId so a pair is one row, not two.
  personAId String
  personA   Person @relation("AccountLinkA", fields: [personAId], references: [id])
  personBId String
  personB   Person @relation("AccountLinkB", fields: [personBId], references: [id])

  // [{ type: "shared_ip" | "shared_kyc_document" | "shared_payment_instrument", value }]
  signals  Json
  strength AccountLinkStrength
  status   AccountLinkStatus   @default(open)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String?

  @@unique([personAId, personBId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Support / messaging (module 4.6) — see src/server/support.ts.
// Statuses per modules-to-design.md §4.6: Open / Awaiting trader / Resolved;
// a trader reply reopens a resolved thread. Attachments reuse the encrypted
// file storage (src/server/kyc-storage.ts); the row is metadata only.
// ---------------------------------------------------------------------------

enum SupportCategory {
  account
  payout
  kyc
  technical
  other
}

enum SupportStatus {
  open
  awaiting_trader
  resolved
}

enum SupportAuthor {
  trader
  admin
}

model SupportThread {
  id            String          @id @default(cuid())
  personId      String
  person        Person          @relation(fields: [personId], references: [id])
  subject       String
  category      SupportCategory @default(other)
  status        SupportStatus   @default(open)
  createdAt     DateTime        @default(now())
  lastMessageAt DateTime        @default(now())
  resolvedAt    DateTime?

  messages SupportMessage[]

  @@index([personId])
  @@index([status, lastMessageAt])
}

model SupportMessage {
  id            String        @id @default(cuid())
  threadId      String
  thread        SupportThread @relation(fields: [threadId], references: [id])
  authorType    SupportAuthor
  authorAdminId String?
  authorAdmin   AdminUser?    @relation(fields: [authorAdminId], references: [id])
  body          String
  createdAt     DateTime      @default(now())

  attachments SupportAttachment[]

  @@index([threadId, createdAt])
}

model SupportAttachment {
  id           String         @id @default(cuid())
  messageId    String
  message      SupportMessage @relation(fields: [messageId], references: [id])
  storageKey   String         @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  checksum     String
}

enum EmailStatus {
  queued
  sent
  failed
  skipped
}

/// Admin-editable wording for each transactional email. A row overrides the
/// built-in default in src/server/email/defaults.ts; no row means the default.
model EmailTemplate {
  key         String   @id
  subject     String
  body        String
  enabled     Boolean  @default(true)
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Every email the system tries to send. Rows are kept (sent or not) so staff
/// can see what a trader was told; failed rows are retried by the background job.
model EmailOutbox {
  id                String      @id @default(cuid())
  personId          String?
  toEmail           String
  templateKey       String
  subject           String
  body              String
  marketing         Boolean     @default(false)
  status            EmailStatus @default(queued)
  attempts          Int         @default(0)
  lastError         String?
  providerMessageId String?
  createdAt         DateTime    @default(now())
  sentAt            DateTime?

  @@index([status, createdAt])
  @@index([personId])
}